# HarvestHub Production Django Backend Environment Configuration

DJANGO_SECRET_KEY=replace-with-a-random-secret-key-or-let-render-generate-it
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True

# Managed Cloud MySQL Provider (e.g. TiDB Serverless, Aiven, Railway, AWS RDS)
MYSQL_DATABASE=harvesthub
MYSQL_USER=your_cloud_mysql_user
MYSQL_PASSWORD=your_cloud_mysql_password
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_SSL=True

# Or full database connection URL:
# DATABASE_URL=mysql://user:password@host:port/harvesthub

# Frontend Origin (your deployed Vercel domain)
FRONTEND_ORIGIN=https://harvesthub-frontend.vercel.app
